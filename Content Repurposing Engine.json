    {
      "parameters": {
        "jsCode": "// Turns whichever branch ran into one clean, consistent item.\nconst form = $('Content Intake Form').first().json;\nconst incoming = ($input.first() && $input.first().json) || {};\nconst type = form['Source Type'];\nconst url = String(form['Source URL'] || '').trim();\n\nif (type !== 'Paste Text' && !url) {\n  throw new Error('Source URL is required for Article and YouTube sources.');\n}\n\nlet title = '';\nlet text = '';\n\nif (type === 'Article') {\n  const article = String(incoming.article || '').trim();\n  const body = String(incoming.body || '').trim();\n  // Prefer the <article> element; fall back to <body> when the site does not use it.\n  text = article.length > 500 ? article : body;\n  title = String(incoming.title || '').trim() || url;\n} else if (type === 'YouTube') {\n  // Supadata returns { content: \"...\" } when text=true. Change this if you use a different provider.\n  text = typeof incoming.content === 'string' ? incoming.content : String(incoming.transcript || '');\n  title = incoming.title || url;\n} else {\n  text = String(form['Pasted Text'] || '');\n  title = 'Pasted content';\n}\n\ntext = text.replace(/\\s+/g, ' ').trim();\n// Cap sized for the Ollama Context Length of 16384 (roughly 32k characters plus prompt). Raise both together if your machine allows.\nif (text.length > 32000) text = text.slice(0, 32000);\n\nif (text.length < 200) {\n  throw new Error(`Could not extract enough text from the source (${text.length} characters). Check the URL or use the Paste Text option.`);\n}\n\nreturn [{\n  json: {\n    title,\n    sourceUrl: url,\n    sourceType: type,\n    notes: String(form['Campaign Notes'] || '').trim(),\n    text,\n    wordCount: text.split(' ').length,\n  },\n}];"
      },
      "id": "aee2168e-e3ce-4399-a963-77f3b0aaa382",
      "name": "Normalize Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        832
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior content strategist. Read the long-form content below and produce a structured brief that will be used to write social media posts.\n\nBe concrete and specific. Pull real insights, numbers, and phrases from the content rather than generic observations. Quotable lines must be verbatim or near-verbatim from the source. Do not invent anything that is not in the content.\n\nTITLE: {{ $('Normalize Content').first().json.title }}\nSOURCE TYPE: {{ $('Normalize Content').first().json.sourceType }}\nCAMPAIGN NOTES FROM THE TEAM: {{ $('Normalize Content').first().json.notes || 'None' }}\n\nCONTENT:\n{{ $('Normalize Content').first().json.text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        }
      },
      "id": "ed172be9-b699-4309-9871-bd19717d1b23",
      "name": "Analyze Content",
