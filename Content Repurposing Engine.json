      "id": "6fe5fe9e-728b-4919-9e38-769e0319a3e9",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        1728,
        1088
      ],
